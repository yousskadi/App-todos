server {
    # 8080 et non 80 : un port < 1024 exige CAP_NET_BIND_SERVICE, que le
    # securityContext du homelab retire (`drop: ["ALL"]`, `runAsNonRoot`).
    # Docker masque le problème en autorisant les ports bas aux non-root
    # (net.ipv4.ip_unprivileged_port_start=0), pas Kubernetes.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de sécurité. C'est ici qu'ils comptent : le HTML réellement
    # interprété par le navigateur est servi par ce pod, pas par l'API.
    #
    # `always` pour qu'ils tiennent aussi sur les réponses d'erreur (4xx/5xx),
    # que nginx sert sans les en-têtes ajoutés autrement. Et rien dans les
    # blocs `location` : un seul `add_header` dans un `location` annulerait
    # tous ceux hérités du bloc `server`, sans le moindre avertissement.
    #
    # `Strict-Transport-Security` est volontairement absent : le TLS est
    # terminé par la Gateway du homelab, l'en-tête se pose là où la décision
    # TLS est prise.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # CSP établie en observant le build Vite dans un navigateur, pas déduite :
    # - script-src 'self' : Vite ne produit aucun script inline ;
    # - style-src 'unsafe-inline' : imposé par la stack, Radix pose des
    #   attributs `style` et sonner injecte une balise <style> à l'exécution ;
    # - img-src data: : Vite inline les petits assets en URI de données ;
    # - font-src 'self' : Inter est empaquetée (@fontsource), pas prise chez
    #   Google ;
    # - connect-src 'self' : les appels d'API passent par /api/ sur la même
    #   origine, ce proxy existe pour ça.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # SPA : toute route inconnue renvoie index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API : même origine côté navigateur, pas de CORS à ouvrir.
    #
    # BACKEND_URL est substitué au démarrage par le mécanisme de templates de
    # l'image nginx (/etc/nginx/templates). Il ne peut pas rester en dur :
    # nginx résout un upstream littéral au CHARGEMENT de la conf, pas à la
    # requête, et sort en [emerg] « host not found in upstream » si le nom est
    # introuvable. Dans le cluster, `backend` n'existe pas -> CrashLoopBackOff,
    # alors même que le bloc n'y sert à rien (la Gateway route /api vers le
    # Service backend avant d'atteindre ce pod).
    #
    # Sans slash final : `proxy_pass .../;` amputerait le préfixe /api attendu
    # par l'API.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
